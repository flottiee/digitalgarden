# Шаблон окружения для docker-compose.yml на сервере.
# Реальный .env создаётся НА СЕРВЕРЕ в /srv/storage/services/backend/.env
# (chmod 600, в git не попадает).

# Имя суперпользователя и базы внутри PostgreSQL.
# Строка подключения дляbackend-приложения получается такой:
#   postgresql+asyncpg://<user>:<password>@db:5432/<db>
POSTGRES_USER=flottiee
POSTGRES_DB=flottiee

# Пароль генерируется на сервере:
#   printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 24)" >> .env
POSTGRES_PASSWORD=change_me
