# Шаблон окружения для docker-compose.yml на сервере.
# Реальный .env создаётся НА СЕРВЕРЕ в /srv/storage/services/backend/.env
# (chmod 600, в git не попадает).

# Имя суперпользователя и базы внутри PostgreSQL.
# Строка подключения дляbackend-приложения получается такой:
#   postgresql+asyncpg://<user>:<password>@db:5432/<db>
POSTGRES_USER=flottiee
POSTGRES_DB=flottiee

# Пароль генерируется на сервере:
#   printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 24)" >> .env
POSTGRES_PASSWORD=change_me

# --- backend api -------------------------------------------------------------

# Строка подключения к основным БД (пароль из POSTGRES_PASSWORD выше):
#   DATABASE_URL=postgresql+asyncpg://flottiee:<password>@db:5432/flottiee
DATABASE_URL=change_me
# Секрет подписи JWT: openssl rand -hex 32
JWT_SECRET=change_me
# Origin-ы, которым разрешено ходить к API из браузера (JSON-список)
CORS_ORIGINS=["https://flottiee.bond"]

# --- токен туннеля Cloudflare (создаётся в dashboard Zero Trust) --------------
# Оставьте пустым, пока туннель не создан
TUNNEL_TOKEN=
