{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "site",
	"compatibility_date": "2026-10-30",
	"main": ".output/server/index.mjs",
	"compatibility_flags": ["nodejs_compat"],
	// внутренний адрес backend API (Tailscale Funnel); знает только Worker, не браузер
	"vars": {
		"NUXT_API_ORIGIN": "https://flottiee-server.tail5d1467.ts.net"
	},
	"assets": {
		"directory": ".output/public"
	},
	"observability": {
		"enabled": true
	}
}
