# Шаблон окружения backend. Реальный backend/.env создаётся локально
# (git его игнорирует, права 600). На сервере переменные задаёт compose.

# Строка подключения к PostgreSQL (внимание на "+asyncpg" — это выбор драйвера):
#   локальная разработка: postgresql+asyncpg://<user>:<password>@localhost:5432/<db>
#   на сервере:           postgresql+asyncpg://<user>:<password>@db:5432/<db>
# db:5432 работает, потому что контейнер api присоединён к сети backend,
# где postgres виден по имени сервиса "db".
DATABASE_URL=postgresql+asyncpg://flottiee@localhost:5432/flottiee_dev

# JWT: секрет для подписи токенов. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change_me
# Срок жизни access-токена: 7 дней (в минутах)
JWT_EXPIRE_MINUTES=10080

# Cookie флага: на проде (за Cloudflare Tunnel всегда https) ставим true
COOKIE_SECURE=false
# SameSite cookie: в dev "lax" (localhost один с айт), на проде — "none"
COOKIE_SAMESITE=lax

# CORS: откуда разрешены запросы к API. JSON-список строк.
CORS_ORIGINS=["http://localhost:3000"]
